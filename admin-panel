<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FL Kits - Admin Panel</title>
<style>
  body { background: #09090b; color: #fff; font-family: sans-serif; padding: 40px 20px; display: flex; justify-content: center; }
  .container { width: 100%; max-width: 500px; background: #18181b; padding: 32px; border-radius: 16px; border: 1px solid #27272a; }
  h2 { margin-bottom: 24px; text-align: center; }
  input, select { width: 100%; padding: 12px; margin-bottom: 16px; background: #121214; border: 1px solid #27272a; color: #fff; border-radius: 8px; font-size: 15px; }
  button { width: 100%; padding: 14px; background: #fff; color: #000; border: none; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer; }
  button:hover { background: #e4e4e7; }
  button:disabled { opacity: 0.5; }
  #mesaj { text-align: center; margin-top: 16px; font-weight: bold; }
</style>
</head>
<body>
<div class="container">
  <h2>Yeni Forma / Logo Ekle</h2>
  <input type="text" id="team" placeholder="Takım Adı (Örn: Fenerbahçe)">
  <input type="text" id="label" placeholder="Forma Türü (Örn: Home Kit)">
  <input type="text" id="sub" placeholder="Alt Başlık (Örn: İç Saha)">
  <select id="category">
    <option value="kits">Forma Kiti</option>
    <option value="logos">Kulüp Logosu</option>
    <option value="national">Milli Takım</option>
    <option value="premium">Premium</option>
  </select>
  <input type="text" id="url" placeholder="Görsel URL'si (https://...)">
  <input type="text" id="country" placeholder="Ülke (Örn: Türkiye)">
  <input type="text" id="flag" placeholder="Bayrak Emojisi (Örn: 🇹🇷)">
  <button id="ekleBtn" onclick="formaEkle()">Sisteme Ekle</button>
  <div id="mesaj"></div>
</div>
<script>
async function formaEkle() {
  const btn = document.getElementById('ekleBtn');
  const mesaj = document.getElementById('mesaj');
  btn.innerText = 'Ekleniyor...'; btn.disabled = true; mesaj.innerText = '';

  const data = {
    token: '#Coogle29.10.26',
    team: document.getElementById('team').value,
    label: document.getElementById('label').value,
    sub: document.getElementById('sub').value,
    category: document.getElementById('category').value,
    url: document.getElementById('url').value,
    country: document.getElementById('country').value,
    flag: document.getElementById('flag').value
  };

  try {
    // DİKKAT: Aşağıdaki linki Vercel'den aldıktan sonra güncelleyeceğiz!
    const res = await fetch('https://BURAYA_VERCEL_LINKINI_YAZ.vercel.app/api/kits', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    
    if (res.ok) {
      mesaj.style.color = '#22c55e'; mesaj.innerText = '✓ Başarıyla eklendi!';
      document.querySelectorAll('input').forEach(i => i.value = '');
    } else {
      mesaj.style.color = '#ef4444'; mesaj.innerText = '✗ Bir hata oluştu.';
    }
  } catch (err) {
    mesaj.style.color = '#ef4444'; mesaj.innerText = '✗ Sunucuya bağlanılamadı.';
  }
  btn.innerText = 'Sisteme Ekle'; btn.disabled = false;
}
</script>
</body>
</html>
